# Copy to .env (never commit it). Only upload.py and publish.py use the API.
# Make a token on your BookStack profile under API Tokens; your role needs the "Access System API" permission.
BOOKSTACK_URL=https://bookstack.example.com
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=

# Optional: a title on the login page (your site logo is shown above it), a line under it, and a footer
LOGIN_TITLE=
LOGIN_SUBTITLE=
LOGIN_FOOTER=

# Optional: your own font stylesheet instead of Google Fonts (e.g. self-hosted)
FONTS_CSS=
